    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/handbase.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Joint6" type="revolute">
  <origin xyz="0 -0.09562 -0.02562" rpy="0.2618 0 0"/>
  <parent link="link5_1_1"/>
  <child link="link6_1_1"/>
  <axis xyz="0 1 0"/>
  <limit lower="-6.28" upper="6.28" effort="30.0" velocity="1.0"/>
</joint>

<link name="gripper_carrier">
  <inertial>
    <mass value="0.001"/>
    <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
  </inertial>
</link>

<joint name="Joint7" type="prismatic">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="link6_1_1"/>
  <child link="gripper_carrier"/>
  <axis xyz="1 0 0"/>
  <limit lower="0.0" upper="0.012" effort="30.0" velocity="0.03"/>
</joint>

<link name="finger_left">
  <inertial>
    <mass value="0.020"/>
    <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
  </inertial>
  <visual>
    <origin xyz="0 0.063 -0.21053" rpy="-0.2618 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/finger_left.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="0 0.063 -0.21053" rpy="-0.2618 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/finger_left.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="finger_left_joint" type="fixed">
  <parent link="gripper_carrier"/>
  <child link="finger_left"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<link name="finger_right">
  <inertial>
    <mass value="0.020"/>
    <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
  </inertial>
  <visual>
    <origin xyz="0 0.063 -0.21053" rpy="-0.2618 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/finger_right.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="0 0.063 -0.21053" rpy="-0.2618 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/finger_right.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="finger_right_joint" type="prismatic">
  <parent link="link6_1_1"/>
  <child link="finger_right"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="-1 0 0"/>
  <limit lower="0.0" upper="0.012" effort="30.0" velocity="0.03"/>
  <mimic joint="Joint7" multiplier="1.0" offset="0.0"/>
</joint>

<link name="camera_bottom_screw_frame"/>

<joint name="camera_mount_joint" type="fixed">
  <parent link="link6_1_1"/>
  <child link="camera_bottom_screw_frame"/>
  <origin xyz="0.009 -0.08 0.010" rpy="0 0 0"/>
</joint>

<link name="camera_link">
  <inertial>
    <mass value="0.072"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
  </inertial>
  <visual>
    <origin xyz="0.0043 -0.0175 0" rpy="1.57079632679 0 1.57079632679"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/d435.dae"/>
    </geometry>
  </visual>
  <collision>
    <origin xyz="0 -0.0175 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.02505 0.090 0.025"/>
    </geometry>
  </collision>
</link>

<joint name="camera_link_joint" type="fixed">
  <origin xyz="0.0106 0.0175 0.0125" rpy="0 0 -1.5708"/>
  <parent link="camera_bottom_screw_frame"/>
  <child link="camera_link"/>
</joint>

<link name="camera_depth_frame"/>
<joint name="camera_depth_joint" type="fixed">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="camera_link"/>
  <child link="camera_depth_frame"/>
</joint>

<link name="camera_depth_optical_frame"/>
<joint name="camera_depth_optical_joint" type="fixed">
  <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  <parent link="camera_depth_frame"/>
  <child link="camera_depth_optical_frame"/>
</joint>

