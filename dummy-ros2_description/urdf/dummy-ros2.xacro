  <origin xyz="0 0.14103 0.03779" rpy="0 0 0"/>
  <parent link="link2_1_1"/>
  <child link="link3_1_1"/>
  <axis xyz="1 0 0"/>
  <limit lower="-1.0" upper="1.65" effort="50.0" velocity="1.0"/>
</joint>

<link name="link4_1_1">
  <inertial>
    <origin xyz="0.001435 0.018414 0.222244" rpy="0 0 0"/>
    <mass value="0.205755"/>
    <inertia ixx="0.000226" ixy="6.70e-06" ixz="1.88e-06" iyy="0.000067" iyz="-4.66e-05" izz="0.000228"/>
  </inertial>
  <visual>
    <origin xyz="0 -0.13923 -0.21054" rpy="-0.2618 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/link4.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="deepgray"/>
  </visual>
  <collision>
    <origin xyz="0 -0.13923 -0.21054" rpy="-0.2618 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/link4.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Joint4" type="revolute">
  <origin xyz="0 -0.02602 0.04686" rpy="0.2618 0 0"/>
  <parent link="link3_1_1"/>
  <child link="link4_1_1"/>
  <axis xyz="0 1 0"/>
  <limit lower="-3.14" upper="3.14" effort="50.0" velocity="1.0"/>
</joint>

<link name="link5_1_1">
  <inertial>
    <origin xyz="-0.004732 -0.070836 0.198355" rpy="0 0 0"/>
    <mass value="0.17716"/>
    <inertia ixx="0.000124" ixy="1.97e-05" ixz="5.12e-06" iyy="0.000056" iyz="-2.22e-05" izz="0.000132"/>
