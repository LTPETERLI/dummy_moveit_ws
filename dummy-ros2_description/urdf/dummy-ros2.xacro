<joint name="Joint5" type="revolute">
  <origin xyz="0 -0.10245 0" rpy="-0.2618 0 0"/>
  <parent link="link4_1_1"/>
  <child link="link5_1_1"/>
  <axis xyz="1 0 0"/>
  <limit lower="-1.75" upper="1.75" effort="50.0" velocity="1.0"/>
</joint>

<link name="link6_1_1">
  <inertial>
    <origin xyz="-0.000152 -0.135449 0.181064" rpy="0 0 0"/>
    <mass value="0.120102"/>
    <inertia ixx="1.70e-05" ixy="2.92e-08" ixz="-5.09e-08" iyy="1.83e-05" iyz="2.28e-07" izz="1.74e-05"/>
  </inertial>
  <visual>
    <origin xyz="0 0.063 -0.21053" rpy="-0.2618 0 0"/>
    <geometry>
