<?xml version="1.0" ?>
<robot name="dummy-ros2" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find dummy-ros2_description)/urdf/materials.xacro" />
<xacro:include filename="$(find dummy-ros2_description)/urdf/dummy-ros2.trans" />
<xacro:include filename="$(find dummy-ros2_description)/urdf/dummy-ros2.gazebo" />

<link name="world" />

<joint name="world_joint" type="fixed">
  <parent link="world" />
  <child link="base_link" />
  <origin xyz="0.0 0.0 0.0" rpy="3.1415926536 3.1415926536 0.0" />
</joint>

<link name="light">
  <visual>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/light.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="red"/>
    <origin xyz="0 -0.001 0" rpy="0 0 0"/>
  </visual>
</link>

<link name="base_link">
  <inertial>
    <mass value="3.091929"/>
    <inertia ixx="0.01097" ixy="-0.000001" ixz="0.00026" iyy="0.01064" iyz="-0.1431" izz="0.0124"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="gray"/>
  </visual>
  <collision>
    <origin xyz="0.000011 -0.015221 0.042123" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="light_fixed" type="fixed">
  <parent link="base_link"/>
  <child link="light"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<link name="link1_1_1">
  <inertial>
    <origin xyz="-0.009794 -0.010032 0.0" rpy="0 0 0"/>
    <mass value="0.057677"/>
    <inertia ixx="3.34e-05" ixy="-1.08e-05" ixz="6.33e-06" iyy="2.72e-05" iyz="9.88e-06" izz="4.04e-05"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/link1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="white"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/link1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Joint1" type="revolute">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="link1_1_1"/>
  <axis xyz="0 0 1"/>
  <limit lower="-3.05" upper="3.05" effort="50.0" velocity="1.0"/>
</joint>

<link name="link2_1_1">
  <inertial>
    <origin xyz="-0.000946 0.034772 0.172834" rpy="0 0 0"/>
    <mass value="0.667158"/>
