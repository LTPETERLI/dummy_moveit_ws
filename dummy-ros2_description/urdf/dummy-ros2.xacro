    <origin xyz="0 0.035 -0.1543" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/link2.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="deepgray"/>
  </visual>
  <collision>
    <origin xyz="0 0.035 -0.1543" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find dummy-ros2_description)/meshes/link2.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Joint2" type="revolute">
  <origin xyz="0 -0.035 0.15475" rpy="0 0 0"/>
  <parent link="link1_1_1"/>
  <child link="link2_1_1"/>
  <axis xyz="1 0 0"/>
  <limit lower="-1.35" upper="1.6" effort="50.0" velocity="1.0"/>
</joint>

<link name="link3_1_1">
  <inertial>
    <origin xyz="0.002113 0.111483 0.243542" rpy="0 0 0"/>
